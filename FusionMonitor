-- Run on a CC:Tweaked computer connected to an AP ME Bridge and 2x1 monitor.
-- Edit CONFIG, then run: throughput
local CONFIG = {
  bridge = nil, -- peripheral name/side, or nil to find automatically
  monitor = nil, -- peripheral name/side, or nil to find automatically
  interval = 0.5, -- seconds between snapshots
  pageSeconds = 1,
  textScale = 0.5,
  redstoneMode = "bundled", -- "bundled" for IE interface connectors, "normal" for plain redstone
  activationSide = "top", -- top/bottom/front/back/left/right, relative to computer
  noFuelSide = "top", -- Can share the activation side when using different bundled colors.
  activationChannel = colors.white, -- IE white channel: activation pulse output
  noFuelChannel = colors.red, -- IE red channel: NO FUEL input (high = alarm)
  pulseSeconds = 0.5,
  inputPollSeconds = 0.2, -- Also poll: do not rely solely on redstone events.
  resources = {
    { kind = "chemical", name = "mekanismgenerators:deuterium", label = "Deuterium" },
    { kind = "chemical", name = "mekanismgenerators:tritium", label = "Tritium" },
  },
}

assert(CONFIG.interval > 0 and CONFIG.pageSeconds > 0, "Intervals must be positive")
assert(CONFIG.pulseSeconds > 0, "Pulse duration must be positive")
assert(CONFIG.inputPollSeconds > 0, "Input polling interval must be positive")
assert(CONFIG.redstoneMode == "bundled" or CONFIG.redstoneMode == "normal",
  "redstoneMode must be bundled or normal")
local validSides = { top = true, bottom = true, front = true, back = true, left = true, right = true }
assert(validSides[CONFIG.activationSide] and validSides[CONFIG.noFuelSide], "Invalid redstone side")
if CONFIG.redstoneMode == "bundled" then
  local function validChannel(channel)
    for bit = 0, 15 do
      if channel == 2 ^ bit then return true end
    end
    return false
  end
  assert(validChannel(CONFIG.activationChannel) and validChannel(CONFIG.noFuelChannel),
    "Bundled channels must each be one colors.* value")
  assert(CONFIG.activationSide ~= CONFIG.noFuelSide or CONFIG.activationChannel ~= CONFIG.noFuelChannel,
    "Use different bundled channels for activation and NO FUEL on the same side")
end
assert(#CONFIG.resources > 0, "Configure at least one resource")
local readers = {
  item = { "getItems", "listItems" },
  fluid = { "getFluids", "listFluid", "listFluids" },
  chemical = { "getChemicals", "listChemicals", "listGas" },
}
for _, resource in ipairs(CONFIG.resources) do
  assert(readers[resource.kind], "Unknown resource kind: " .. tostring(resource.kind))
end

local monitor = CONFIG.monitor and peripheral.wrap(CONFIG.monitor) or peripheral.find("monitor")
assert(monitor, "No monitor found; connect it directly or through wired modems")
local monitorName = peripheral.getName(monitor)
monitor.setTextScale(CONFIG.textScale)
local state, page = {}, 1
local lastError
local pulsing = false
local activateButton, nextButton
local noFuel = false
local bundledInput, normalInput = 0, false

local function setActivation(active)
  if CONFIG.redstoneMode == "bundled" then
    -- Modify only our activation channel; leave other output colors alone.
    local output = redstone.getBundledOutput(CONFIG.activationSide)
    if active then
      output = colors.combine(output, CONFIG.activationChannel)
    else
      output = colors.subtract(output, CONFIG.activationChannel)
    end
    redstone.setBundledOutput(CONFIG.activationSide, output)
  else
    redstone.setOutput(CONFIG.activationSide, active)
  end
end

local function readNoFuel()
  bundledInput = redstone.getBundledInput(CONFIG.noFuelSide)
  normalInput = redstone.getInput(CONFIG.noFuelSide)
  if CONFIG.redstoneMode == "bundled" then
    return colors.test(bundledInput, CONFIG.noFuelChannel)
  end
  return normalInput
end

local function findBridge()
  if CONFIG.bridge then return peripheral.wrap(CONFIG.bridge) end
  return peripheral.find("me_bridge") or peripheral.find("meBridge")
end

-- Read each configured channel once per snapshot; sum component variants by ID.
local function readChannel(bridge, kind)
  for _, method in ipairs(readers[kind]) do
    if type(bridge[method]) == "function" then
      local ok, list, err
      if method:sub(1, 3) == "get" then
        ok, list, err = pcall(bridge[method], {})
      else
        ok, list, err = pcall(bridge[method])
      end
      if not ok then return nil, tostring(list) end
      if type(list) ~= "table" then return nil, tostring(err or "Bridge returned no data") end
      local totals = {}
      for _, entry in pairs(list) do
        if type(entry) == "table" then
          local id = entry.name or entry.id
          local amount = tonumber(entry.amount or entry.count)
          if id and amount then totals[id] = (totals[id] or 0) + amount end
        end
      end
      return totals
    end
  end
  return nil, "No " .. kind .. " listing API on this bridge"
end

local function snapshot()
  local bridge = findBridge()
  local channels, errors = {}, {}
  if bridge then
    -- Avoid interpreting an offline network as an empty network.
    local online = true
    for _, method in ipairs({ "isConnected", "isOnline" }) do
      if type(bridge[method]) == "function" then
        local ok, value = pcall(bridge[method])
        if not ok or value == false then online = false end
      end
    end
    if online then
      for _, resource in ipairs(CONFIG.resources) do
        if channels[resource.kind] == nil and errors[resource.kind] == nil then
          channels[resource.kind], errors[resource.kind] = readChannel(bridge, resource.kind)
        end
      end
    else
      bridge = nil
    end
  end
  local now = os.epoch("utc") / 1000
  lastError = nil
  for i, resource in ipairs(CONFIG.resources) do
    local previous = state[i]
    local totals = channels[resource.kind]
    if not totals then
      local message = errors[resource.kind] or "ME Bridge missing/offline"
      state[i] = { error = message }
      lastError = message
    else
      local amount = totals[resource.name] or 0
      local nextState = { amount = amount, time = now }
      if previous and previous.time and now > previous.time then
        nextState.delta = amount - previous.amount
        nextState.elapsed = now - previous.time
        nextState.rate = nextState.delta / nextState.elapsed
      end
      state[i] = nextState
    end
  end
end

local function number(value, signed)
  local absolute = math.abs(value)
  local suffix, divisor = "", 1
  if absolute >= 1e9 then suffix, divisor = "G", 1e9
  elseif absolute >= 1e6 then suffix, divisor = "M", 1e6
  elseif absolute >= 1e3 then suffix, divisor = "k", 1e3 end
  local result = string.format("%.1f%s", value / divisor, suffix)
  if signed and value > 0 then result = "+" .. result end
  return result
end

local function draw()
  local width, height = monitor.getSize()
  local pages = #CONFIG.resources
  page = ((page - 1) % pages) + 1
  local function line(y, text, colour)
    if y < 1 or y > height then return end
    monitor.setCursorPos(1, y)
    monitor.setTextColor(colour or colors.white)
    monitor.write(text:sub(1, width))
  end
  monitor.setBackgroundColor(colors.black)
  monitor.clear()
  line(1, "FUSION " .. page .. "/" .. pages, colors.cyan)
  line(2, noFuel and "NO FUEL" or "ALARM: -", noFuel and colors.red or colors.lime)
  -- One resource per page leaves a blank line between status, data and controls.
  do
    local resource, value = CONFIG.resources[page], state[page]
    local unit = resource.unit or (resource.kind == "item" and "i" or "mB")
    local shortNames = {
      ["mekanism:dust_lithium"] = "Li dust",
      ["modern_industrialization:deuterium"] = "D2 fluid",
      ["mekanism:lithium"] = "Li gas",
      ["mekanismgenerators:deuterium"] = "D2 gas",
      ["mekanismgenerators:tritium"] = "T2 gas",
    }
    line(4, resource.shortLabel or shortNames[resource.name] or resource.label or resource.name)
    if not value or value.error then
      line(5, "ME ERROR", colors.red)
    else
      line(5, "S " .. number(value.amount) .. " " .. unit, colors.lightGray)
      if value.rate then
        local colour = value.rate > 0 and colors.lime or (value.rate < 0 and colors.red or colors.lightGray)
        line(6, "R " .. number(value.rate, true) .. "/s", colour)
        line(7, "D " .. number(value.delta, true), colour)
      else
        line(6, "WAIT...", colors.yellow)
      end
    end
    if height >= 12 then line(height - 3, "dt " .. CONFIG.interval .. "s", colors.gray) end
  end
  local function button(x, text, background)
    monitor.setCursorPos(x, height - 1)
    monitor.setBackgroundColor(background)
    monitor.setTextColor(colors.white)
    monitor.write(text)
    monitor.setBackgroundColor(colors.black)
    return { x1 = x, x2 = x + #text - 1, y = height - 1 }
  end
  activateButton = button(1, pulsing and " PULSE " or " ACT ", pulsing and colors.orange or colors.green)
  nextButton = button(width - 4, " > ", colors.blue)
  -- Raw bundled mask in hex: red alone is 4000. Plain input is shown as I.
  line(height, string.format("B:%04X I:%d", bundledInput, normalInput and 1 or 0), colors.gray)
end

local function contains(button, x, y)
  return button and y == button.y and x >= button.x1 and x <= button.x2
end

-- Keep pulse timing independent of slow bridge queries or monitor redraws.
local function pulseWorker()
  while true do
    os.pullEvent("fusion_activate")
    setActivation(true)
    sleep(CONFIG.pulseSeconds)
    setActivation(false)
    pulsing = false
    os.queueEvent("fusion_pulse_finished")
  end
end

local function inputWorker()
  while true do
    local oldBundled, oldNormal = bundledInput, normalInput
    local alarm = readNoFuel()
    if alarm ~= noFuel or oldBundled ~= bundledInput or oldNormal ~= normalInput then
      noFuel = alarm
      os.queueEvent("fusion_input_changed")
    end
    sleep(CONFIG.inputPollSeconds)
  end
end

local function runDisplay()
  print("Fusion controller running. Ctrl+T to stop.")
  noFuel = readNoFuel()
  draw()
  snapshot()
  draw()
  local sampleTimer = os.startTimer(CONFIG.interval)
  local pageTimer = os.startTimer(CONFIG.pageSeconds)
  while true do
    local event, id, x, y = os.pullEvent()
    if event == "timer" and id == sampleTimer then
      snapshot()
      sampleTimer = os.startTimer(CONFIG.interval)
      noFuel = readNoFuel()
      draw()
    elseif event == "timer" and id == pageTimer then
      page = page + 1
      pageTimer = os.startTimer(CONFIG.pageSeconds)
      draw()
    elseif event == "monitor_touch" and id == monitorName then
      if contains(activateButton, x, y) and not pulsing then
        pulsing = true
        os.queueEvent("fusion_activate")
      elseif contains(nextButton, x, y) then
        page = page + 1
      end
      draw()
    elseif event == "redstone" or event == "fusion_pulse_finished" or event == "fusion_input_changed" then
      noFuel = readNoFuel()
      draw()
    elseif event == "monitor_resize" and id == monitorName then
      draw()
    end
  end
end

setActivation(false)
local ok, err = pcall(function()
  parallel.waitForAny(pulseWorker, inputWorker, runDisplay)
end)
-- Also clear the activation output on Ctrl+T or a runtime error.
setActivation(false)
if not ok then error(err, 0) end
