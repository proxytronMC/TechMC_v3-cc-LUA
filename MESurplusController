
-- AE2 SURPLUS EXPORT CONTROLLER
-- CONFIGURATION -----------------------

local target = "back"

local monitorName = "left"
local itemSpacing = 2

local scanInterval = 2
local batchSize = 128

-- Minimum stock to KEEP in AE2
local reserves = {
    ["minecraft:netherrack"] = 2500,
    ["minecraft:soul_sand"] = 500,
    ["minecraft:soul_soil"] = 128,
    ["minecraft:gravel"] = 128,
    ["minecraft:andesite"] = 1500,
    ["minecraft:granite"] = 1500,
    ["minecraft:diorite"] = 1500,
    ["minecraft:end_stone"] = 128,
}

-- PERIPHERALS -------------------------

local bridge = peripheral.find("meBridge")
local monitor = peripheral.wrap(monitorName)

if not bridge then
    error("ME Bridge not found")
end

if not monitor then
    error("Monitor not found" .. monitorName)
end

monitor.setTextScale(0.5)

-- STATE -------------------------------

local stock = {}
local exported = {}
local names = {}
local page = 1
local editItem = nil
local editValue = ""
local message = "Starting..."
local lastError = nil

-- SETTINGS ----------------------------

local settingsFile = "surplus_reserves.txt"

local function saveSettings()
    local file = fs.open(settingsFile, "w")

    if not file then
        error("Cannot save reserve settings")
    end

    file.write(textutils.serialize(reserves))
    file.close()
end

local function loadSettings()
    if not fs.exists(settingsFile) then
        return
    end

    local file = fs.open(settingsFile, "r")
    if not file then return end

    local data = textutils.unserialize(
        file.readAll()
    )
    file.close()

    if type(data) ~= "table" then return end

    for name, value in pairs(data) do
        if reserves[name] ~= nil and
           type(value) == "number" and
           value >= 0 and
           value <= 999999999 and
           value == math.floor(value) then

            reserves[name] = value
        end
    end
end

local function updateNames()
    names = {}

    for name in pairs(reserves) do
        table.insert(names, name)
    end

    table.sort(names)
end

loadSettings()
updateNames()

-- ITEM STOCK --------------------------

local function getStock()
    local items = bridge.listItems()
    local result = {}

    if type(items) ~= "table" then
        error("ME Bridge listItems failed")
    end

    for _, item in pairs(items) do
        if reserves[item.name] ~= nil then
            local amount = tonumber(
                item.count or item.amount
            ) or 0

            result[item.name] =
                (result[item.name] or 0)
                + amount
        end
    end

    return result
end

-- EXPORT ------------------------------

local function exportSurplus()
    local currentStock = getStock()
    local currentExported = {}

    lastError = nil

    for _, name in ipairs(names) do
        local available = currentStock[name] or 0
        local reserve = reserves[name]

        local surplus = math.max(
            0, available - reserve
        )

        currentExported[name] = 0

        if surplus > 0 then
            local amount = math.min(
                surplus, batchSize
            )

            local ok, result, err = pcall(
                bridge.exportItem,
                {
                    name = name,
                    count = amount
                },
                target
            )

            if ok then
                if type(result) == "number" then
                    currentExported[name] = result

                elseif type(result) == "table" then
                    currentExported[name] =
                        tonumber(result.count)
                        or tonumber(result.amount)
                        or tonumber(result.transferred)
                        or 0
                end

                if err then
                    lastError = tostring(err)
                end
            else
                lastError = tostring(result)
            end
        end
    end

    stock = currentStock
    exported = currentExported

    if lastError then
        message = "Export error"
    else
        message = "Monitoring active"
    end
end

-- MONITOR HELPERS ---------------------

local buttons = {}

local function drawText(x, y, value, fg, bg)
    local w, h = monitor.getSize()

    if x < 1 or y < 1 or x > w or y > h then
        return
    end

    monitor.setCursorPos(x, y)

    monitor.setTextColor(fg or colors.white)
    monitor.setBackgroundColor(bg or colors.black)

    monitor.write(
        tostring(value):sub(1, w - x + 1)
    )
end

local function drawBar(y, label, colour, action)
    local w, h = monitor.getSize()

    if y < 1 or y > h then return end

    monitor.setCursorPos(1, y)
    monitor.setBackgroundColor(colour)
    monitor.write(string.rep(" ", w))

    drawText(2, y, label, colors.white, colour)

    if action then
        table.insert(buttons, {
            x1 = 1, x2 = w,
            y1 = y, y2 = y,
            action = action
        })
    end
end

local function addButton(x1, y1, x2, y2, action)
    table.insert(buttons, {
        x1 = x1, y1 = y1,
        x2 = x2, y2 = y2,
        action = action
    })
end

local function formatNumber(n)
    n = math.floor(n or 0)

    local s = tostring(n)

    while true do
        local new, count = s:gsub(
            "^(-?%d+)(%d%d%d)",
            "%1,%2"
        )

        s = new

        if count == 0 then break end
    end

    return s
end

local function shortName(name)
    return name:match(":(.+)$") or name
end

-- PAGINATION --------------------------

local function getLayout()
    local w, h = monitor.getSize()

    local firstRow = 5
    local footerRow = h - 3

    local rowHeight = 3 + itemSpacing

    local perPage = math.max(
        1,
        math.floor(
            (footerRow - firstRow) / rowHeight
        )
    )

    local totalPages = math.max(
        1,
        math.ceil(#names / perPage)
    )

    page = math.max(
        1,
        math.min(page, totalPages)
    )

    return w, h, perPage, totalPages
end

-- DASHBOARD ---------------------------

local function drawDashboard()
    local w, h, perPage, totalPages =
        getLayout()

    monitor.setBackgroundColor(colors.black)
    monitor.clear()
    buttons = {}

    drawBar(
        1,
        " ME SURPLUS CONTROL",
        colors.blue
    )

    drawText(
        2, 2,
        "Status: " .. message,
        lastError and colors.red or colors.lime
    )

    drawText(
        2, 3,
        "Items: " .. #names ..
        "  Page: " .. page .. "/" .. totalPages,
        colors.lightGray
    )

    drawText(
        2, 4,
        "Touch an item to edit reserve",
        colors.yellow
    )

    local startIndex = (page - 1)
        * perPage + 1

    for i = 1, perPage do
        local index = startIndex + i - 1
        local name = names[index]

        if name then
            local y = 5 + (i - 1) * (3 + itemSpacing)

            local current = stock[name] or 0
            local reserve = reserves[name]
            local moved = exported[name] or 0
            local surplus = math.max(
                0, current - reserve
            )

            drawText(
                2, y,
                shortName(name),
                colors.cyan
            )

            drawText(
                2, y + 1,
                "Stock: " .. formatNumber(current) ..
                "  Min: " .. formatNumber(reserve),
                colors.white
            )

            drawText(
                2, y + 2,
                "Excess: " .. formatNumber(surplus) ..
                "  Out: " .. formatNumber(moved),
                moved > 0
                    and colors.lime
                    or colors.lightGray
            )

            addButton(
                1, y, w, y + 2,
                {type = "edit", name = name}
            )
        end
    end

    local mid = math.floor(w / 2)

    drawText(
        2, h - 2,
        "< PREV",
        colors.yellow
    )

    drawText(
        mid + 2, h - 2,
        "NEXT >",
        colors.yellow
    )

    addButton(
        1, h - 2, mid, h - 2,
        {type = "prev"}
    )

    addButton(
        mid + 1, h - 2, w, h - 2,
        {type = "next"}
    )

    drawBar(
        h,
        "REFRESH STOCK",
        colors.gray,
        {type = "refresh"}
    )
end

-- RESERVE EDITOR ----------------------

local function drawEditor()
    local w, h = monitor.getSize()

    monitor.setBackgroundColor(colors.black)
    monitor.clear()
    buttons = {}

    drawBar(
        1,
        " EDIT RESERVE",
        colors.blue
    )

    drawText(
        2, 3,
        shortName(editItem),
        colors.cyan
    )

    drawText(
        2, 5,
        "Current: " ..
        formatNumber(reserves[editItem]),
        colors.lightGray
    )

    drawText(
        2, 7,
        "New minimum:",
        colors.yellow
    )

    drawText(
        2, 9,
        editValue == "" and "0" or editValue,
        colors.white
    )

    -- Numeric keypad
    local keys = {
        {"1", "2", "3"},
        {"4", "5", "6"},
        {"7", "8", "9"},
        {"C", "0", "<"}
    }

    local keyWidth = math.floor(w / 3)
    local keyHeight = 2
    local startY = 12

    for r = 1, 4 do
        for c = 1, 3 do
            local key = keys[r][c]

            local x1 = (c - 1) * keyWidth + 1
            local x2 = c == 3
                and w or c * keyWidth

            local y1 = startY +
                (r - 1) * keyHeight

            local y2 = y1 + keyHeight - 1

            for yy = y1, y2 do
                monitor.setBackgroundColor(
                    colors.gray
                )

                monitor.setCursorPos(x1, yy)
                monitor.write(
                    string.rep(" ", x2 - x1 + 1)
                )
            end

            drawText(
                x1 + math.floor(
                    (x2 - x1) / 2
                ),
                y1,
                key,
                colors.white,
                colors.gray
            )

            addButton(
                x1, y1, x2, y2,
                {type = "key", value = key}
            )
        end
    end

    drawBar(
        h - 3,
        "SAVE RESERVE",
        colors.green,
        {type = "save"}
    )

    drawBar(
        h - 1,
        "CANCEL",
        colors.red,
        {type = "cancel"}
    )
end

local function draw()
    if editItem then
        drawEditor()
    else
        drawDashboard()
    end
end

-- INPUT HANDLING ----------------------

local function handleKey(key)
    if key == "C" then
        editValue = ""

    elseif key == "<" then
        editValue = editValue:sub(1, -2)

    elseif #editValue < 9 then
        editValue = editValue .. key
    end
end

local function handleTouch(x, y)
    for _, button in ipairs(buttons) do
        if x >= button.x1 and
           x <= button.x2 and
           y >= button.y1 and
           y <= button.y2 then

            local action = button.action

            if action.type == "edit" then
                editItem = action.name
                editValue = tostring(
                    reserves[editItem]
                )

            elseif action.type == "key" then
                handleKey(action.value)

            elseif action.type == "save" then
                if editItem then
                    local value = tonumber(
                        editValue
                    ) or 0

                    reserves[editItem] = value
                    saveSettings()

                    editItem = nil
                    message = "Reserve saved"
                end

            elseif action.type == "cancel" then
                editItem = nil

            elseif action.type == "prev" then
                page = math.max(1, page - 1)

            elseif action.type == "next" then
                local _, _, _, maxPage =
                    getLayout()

                page = math.min(
                    maxPage, page + 1
                )

            elseif action.type == "refresh" then
                local ok, err = pcall(
                    exportSurplus
                )

                if not ok then
                    message = "Scan failed"
                    lastError = tostring(err)
                end
            end

            draw()
            return
        end
    end
end

-- MAIN LOOP ---------------------------

local function scan()
    local ok, err = pcall(exportSurplus)

    if not ok then
        lastError = tostring(err)
        message = "Scan error"
        print("Scan error: " .. tostring(err))
    end

    draw()
end

scan()

local timer = os.startTimer(scanInterval)

while true do
    local event, a, b, c = os.pullEvent()

    if event == "monitor_touch" then
        if a == monitorName then
            handleTouch(b, c)
        end

    elseif event == "monitor_resize" then
        draw()

    elseif event == "timer" and a == timer then
        scan()
        timer = os.startTimer(scanInterval)
    end
end
