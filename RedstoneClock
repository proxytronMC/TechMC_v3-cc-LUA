-- CC:TWEAKED REDSTONE CLOCK

-- CONFIGURATION
local inputSide = "right"
local outputSide = "top"

local pulseLength = 0.5
local pulseInterval = 2

-- FUNCTIONS
local function setOutput(state)
    redstone.setOutput(outputSide, state)

    term.clear()
    term.setCursorPos(1, 1)

    print("=== REDSTONE CLOCK ===")
    print("")
    print("Input: " .. tostring(redstone.getInput(inputSide)))
    print("Output: " .. (state and "ON" or "OFF"))
    print("")
    print("Pulse length: " .. pulseLength .. "s")
    print("Interval: " .. pulseInterval .. "s")
end

-- MAIN LOOP
redstone.setOutput(outputSide, false)

while true do
    if redstone.getInput(inputSide) then
        setOutput(true)
        sleep(pulseLength)

        setOutput(false)
        sleep(pulseInterval)
    else
        setOutput(false)
        sleep(0.1)
    end
end
